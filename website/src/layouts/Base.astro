---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Course site for Smart Prosthetics and Robotic Systems, Rutgers BME." } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <!-- Class gate: a speed bump against bots and passers-by, not security. The
         pages are still plain static HTML. It runs before first paint so the page
         never flashes, and remembers the browser once unlocked. -->
    <script is:inline>
      try { if (localStorage.getItem("spr-gate") !== "ok") document.documentElement.classList.add("gated"); }
      catch { document.documentElement.classList.add("gated"); }
    </script>
    <style is:inline>
      html.gated body > :not(#gate) { display: none !important; }
      html:not(.gated) #gate { display: none; }
    </style>
  </head>
  <body class="font-sans antialiased">
    <div id="gate" class="flex min-h-screen items-center justify-center bg-card px-4">
      <form id="gate-form" class="w-full max-w-sm rounded-xl border border-line bg-white p-6 shadow-sm">
        <div class="mb-4 flex items-center gap-2.5">
          <span class="inline-block h-6 w-1.5 rounded-full bg-scarlet"></span>
          <span class="text-[15px] font-bold tracking-tight text-ink">Smart Prosthetics and Robotic Systems</span>
        </div>
        <label for="gate-pw" class="block text-sm text-body">Enter the course password to continue.</label>
        <input id="gate-pw" type="password" inputmode="numeric" autocomplete="off" required autofocus
               class="mt-2 w-full rounded-md border border-line px-3 py-2 text-ink focus:border-scarlet focus:outline-none" />
        <p id="gate-err" class="mt-2 hidden text-sm text-scarlet">That is not the password.</p>
        <button type="submit" class="mt-4 w-full rounded-md bg-scarlet px-3 py-2 font-semibold text-white hover:opacity-90">Enter</button>
        <p class="mt-4 text-xs text-muted">BME 14:125:444 · Rutgers University.</p>
      </form>
    </div>
    <script is:inline>
      document.getElementById("gate-form").addEventListener("submit", (e) => {
        e.preventDefault();
        if (document.getElementById("gate-pw").value.trim() === "444") {
          try { localStorage.setItem("spr-gate", "ok"); } catch {}
          document.documentElement.classList.remove("gated");
        } else {
          document.getElementById("gate-err").classList.remove("hidden");
        }
      });
    </script>
    <header class="sticky top-0 z-40 border-b border-line bg-white/95 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6">
        <a href={base} class="flex items-center gap-2.5 text-ink no-underline">
          <span class="inline-block h-6 w-1.5 rounded-full bg-scarlet"></span>
          <span class="sr-only whitespace-nowrap text-[15px] font-bold tracking-tight sm:not-sr-only">Smart Prosthetics and Robotic Systems</span>
          <span class="hidden text-sm text-muted lg:inline">· BME 14:125:444</span>
        </a>
        <nav class="flex items-center gap-4 text-sm font-medium text-body">
          <a href={`${base}assembly/`} class="hover:text-scarlet">Assembly guide</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="mt-24 border-t border-line">
      <div class="mx-auto max-w-7xl px-4 py-8 pb-24 text-sm text-muted sm:px-6">
        Dr. Adam Gormley · Department of Biomedical Engineering, Rutgers University.
      </div>
    </footer>
  </body>
</html>
