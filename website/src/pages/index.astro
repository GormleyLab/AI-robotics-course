---
import Base from "../layouts/Base.astro";
const base = import.meta.env.BASE_URL;
---
<Base title="Smart Prosthetics and Robotic Systems">
  <main class="mx-auto max-w-3xl px-4 pt-14 sm:px-6">
    <p class="text-xs font-bold uppercase tracking-wider text-scarlet">BME 14:125:444 · Spring 2027</p>
    <h1 class="mt-2 text-4xl font-extrabold leading-tight tracking-tight text-ink sm:text-5xl">Smart Prosthetics and Robotic Systems</h1>
    <p class="mt-4 font-serif text-xl leading-relaxed text-body">
      Students design, build and program a multi-axis robotic arm, controlled through Python on an
      Arduino, with machine vision and natural-language commands.
    </p>
    <a href={`${base}assembly/`} class="group mt-10 block rounded-2xl border border-line p-6 no-underline transition hover:border-scarlet">
      <p class="text-xs font-bold uppercase tracking-wider text-scarlet">Draft for TA review</p>
      <p class="mt-1 text-xl font-bold text-ink group-hover:text-scarlet">Assembly guide: gearbox, base and shoulder →</p>
      <p class="mt-1 text-body">Build the gearbox, base and shoulder from printed and bought parts: three chapters and 34 illustrated steps. Record what happened at each one.</p>
    </a>
  </main>
</Base>
