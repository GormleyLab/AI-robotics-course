---
// The guide's front page: the chapters as cards, then CAD/docs/assembly-guide.md.
import Guide from "../../layouts/Guide.astro";
import { chapters } from "../../lib/chapters.mjs";
import { Content, getHeadings } from "../../../../CAD/docs/assembly-guide.md";

const base = import.meta.env.BASE_URL;
---
<Guide title="Assembly guide · Smart Prosthetics and Robotic Systems"
       eyebrow="Draft for TA review"
       heading="Robotic Arm Assembly Guide"
       intro="From a pile of printed and bought parts to a complete arm, ready for its gripper and wiring."
       headings={getHeadings()}>
  <Fragment slot="before">
    <ol class="mt-8 space-y-5">
      {chapters.map((c) => (
        <li>
          <a href={`${base}assembly/${c.slug}/`} class="group block rounded-2xl border border-line p-6 no-underline transition hover:border-scarlet hover:shadow-[0_8px_30px_-12px_rgba(204,0,51,0.25)]">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <p class="text-xs font-bold uppercase tracking-wider text-scarlet">Chapter {c.number}</p>
              <p class="text-sm text-muted">{c.steps}</p>
            </div>
            <h2 class="mt-1.5 text-2xl font-bold text-ink group-hover:text-scarlet">{c.title}</h2>
            <p class="mt-2 font-serif text-[1.05rem] leading-relaxed text-body">{c.blurb}</p>
          </a>
        </li>
      ))}
    </ol>

    <div class="fb">
      <p class="fb-title">How to review this guide</p>
      <p class="fb-q">
        Build each chapter by following the guide exactly as written. Where it's wrong or unclear, don't
        work around it silently: say what you did in that step's review box. Students will have only these pages.
      </p>
      <p class="fb-q">
        <strong>Pause at each step's box</strong> and answer what you can. Tell us whether a problem is with the
        guide or with the design. Each chapter ends with a review of the whole chapter.
      </p>
      <p class="fb-q">
        <strong>You don't have to build it all at once.</strong> Answers from every chapter save together in this
        browser as you type, so you can stop and come back on the same device. They stay only in this browser, so
        clearing your browsing data or using a private window can lose them. <strong>At the end of every
        session, use Download my answers and send the file to Dr. Gormley.</strong> Each file holds everything
        so far, so the newest replaces the earlier ones.
      </p>
      <p class="fb-q">
        To continue on another device, download your answers here and use <strong>Restore</strong> there.
        Restore replaces everything in that browser with the file, so always restore your newest file.
      </p>
      <div id="review-reviewer"></div>
    </div>
  </Fragment>
  <Content />
</Guide>
